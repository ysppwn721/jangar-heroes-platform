# Content-addressed assets are immutable: changing one produces a new URL.
/models/v/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable

/src/*.js
  Cache-Control: public, max-age=31536000, immutable

/style.*.css
  Cache-Control: public, max-age=31536000, immutable

# The document and its stable entry points are revalidated so a deploy is picked up.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/style.css
  Cache-Control: no-cache

/src/viewer.js
  Cache-Control: no-cache

/models/*
  Cache-Control: no-cache

/favicon.svg
  Cache-Control: public, max-age=86400

/*
  X-Content-Type-Options: nosniff
